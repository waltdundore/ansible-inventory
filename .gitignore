# ==============================================================================
# Ansible Inventory - Git Ignore
# ==============================================================================

# Ignore actual inventory files (environment-specific, contain private data)
dev/hosts.yml
prod/hosts.yml
workstation/hosts.yml

# Keep group_vars
!dev/group_vars/
!prod/group_vars/
!workstation/group_vars/

# OS Files
.DS_Store
Thumbs.db

# IDE Files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary Files
*.tmp
*.bak
*.backup
*.log
Makefile.dev

# Developer Makefiles
Makefile.dev
Makefile.client
